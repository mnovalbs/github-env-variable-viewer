---
import Breadcrumbs from "@src/components/Breadcrumbs";
import VariableList from "@src/components/VariableList";
import Layout from "@src/layouts/Layout.astro";
import {
  createEnvironmentVariable,
  errorMessage,
  updateEnvironmentVariable,
  getRepository,
  getVariables,
} from "@src/utils/request";

const { orgName = "", repoName = "", envName = "" } = Astro.params;

const isProd = envName.toLowerCase().startsWith('prod')

let error = "";
let loadError = "";
let variables: Awaited<ReturnType<typeof getVariables>> = [];
let repositoryId: number | undefined;

try {
  ({ id: repositoryId } = await getRepository({ orgName, repoName }));
} catch (e) {
  loadError = `Failed to load repository: ${errorMessage(e)}`;
}

if (repositoryId !== undefined && Astro.request.method === "POST") {
  if (isProd) {
    error = "Production environment is read-only";
  } else if (Astro.request.headers.get("origin") !== Astro.url.origin) {
    // CSRF guard: anyone can POST here and we act with the server's token
    error = "Invalid request origin";
  } else {
    const formData = await Astro.request.formData();
    const name = formData.get("name")?.toString() ?? "";
    const updatedName = formData.get("updatedName")?.toString() ?? "";
    const updatedValue = formData.get("updatedValue")?.toString() ?? "";

    try {
      if (name) {
        await updateEnvironmentVariable({
          name,
          updatedName,
          updatedValue,
          repositoryId,
          envName,
        });
      } else {
        await createEnvironmentVariable({
          name: updatedName,
          value: updatedValue,
          repositoryId,
          envName,
        });
      }
      // Post/Redirect/Get so a refresh doesn't resubmit the form
      return Astro.redirect(Astro.url.pathname);
    } catch (e) {
      error = `Failed to save variable: ${errorMessage(e)}`;
    }
  }
}

if (repositoryId !== undefined) {
  try {
    variables = await getVariables({ repositoryId, envName });
  } catch (e) {
    loadError = `Failed to load variables: ${errorMessage(e)}`;
  }
}
---

<Layout errors={[error, loadError]}>
  <Breadcrumbs names={[orgName, repoName, envName]} />
  <VariableList variables={variables} envName={envName} client:visible />
</Layout>
