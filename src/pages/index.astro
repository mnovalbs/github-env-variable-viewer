---
import Layout from "@src/layouts/Layout.astro";
import OrganizationList from "@src/components/OrganizationList";
import { emptyShell, errorMessage, getShellData } from "@src/utils/request";

let shell = emptyShell;
let error = "";

try {
  shell = await getShellData({});
} catch (e) {
  error = `Failed to load organizations: ${errorMessage(e)}`;
}
---

<Layout breadcrumbs={[]} shell={shell} errors={[error]}>
  <OrganizationList organizations={shell.organizations} client:load />
</Layout>
